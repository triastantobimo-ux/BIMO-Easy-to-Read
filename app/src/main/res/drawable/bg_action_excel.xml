<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0F6B43" />
            <stroke android:width="1dp" android:color="@color/accent_secondary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_excel" />
            <stroke android:width="1dp" android:color="@color/accent_excel" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
