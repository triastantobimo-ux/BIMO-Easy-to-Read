<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/surface_top"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_icon"
            android:src="@drawable/ic_app_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/settings"
            android:elevation="2dp"
            android:padding="12dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_tab_container"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/tabInput"
            style="@style/Widget.EasyRead.Tab"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="@string/tab_input"
            android:textColor="@color/accent_secondary" />

        <Button
            android:id="@+id/tabOutput"
            style="@style/Widget.EasyRead.Tab"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:text="@string/tab_output"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/inputPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/select_source"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/input_instruction"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonGallery"
                    style="@style/Widget.EasyRead.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:elevation="3dp"
                    android:text="@string/choose_image" />

                <Button
                    android:id="@+id/buttonCamera"
                    style="@style/Widget.EasyRead.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:elevation="2dp"
                    android:text="@string/take_photo" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_input_surface"
                android:clipToOutline="true"
                android:contentDescription="@string/image_preview"
                android:minHeight="180dp"
                android:padding="10dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/no_image"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/privacy_note"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/outputPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_utility_bar"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/textResultMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_status_dot"
                    android:drawablePadding="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/no_result_meta"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonTextSmaller"
                    style="@style/Widget.EasyRead.TextScale"
                    android:layout_width="48dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/text_smaller"
                    android:text="A−" />

                <TextView
                    android:id="@+id/textScaleValue"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:text="@string/text_scale_default"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonTextLarger"
                    style="@style/Widget.EasyRead.TextScale"
                    android:layout_width="48dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/text_larger"
                    android:text="A+" />
            </LinearLayout>

            <EditText
                android:id="@+id/editResult"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editor"
                android:fadeScrollbars="false"
                android:gravity="start|top"
                android:hint="@string/result_hint"
                android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="26dp"
                android:paddingBottom="20dp"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbarSize="8dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
                android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_action_shelf"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/buttonCopy"
                    style="@style/Widget.EasyRead.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_copy"
                    android:drawablePadding="2dp"
                    android:enabled="false"
                    android:text="@string/copy" />

                <Button
                    android:id="@+id/buttonShare"
                    style="@style/Widget.EasyRead.Button.Command"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_share"
                    android:drawablePadding="2dp"
                    android:enabled="false"
                    android:text="@string/share" />

                <Button
                    android:id="@+id/buttonMarkdown"
                    style="@style/Widget.EasyRead.Button.Command"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_markdown"
                    android:drawablePadding="2dp"
                    android:enabled="false"
                    android:text="@string/markdown_short" />

                <Button
                    android:id="@+id/buttonDocx"
                    style="@style/Widget.EasyRead.Button.Command"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/ic_word"
                    android:drawablePadding="2dp"
                    android:enabled="false"
                    android:text="@string/word_short" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
