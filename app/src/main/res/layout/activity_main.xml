<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <LinearLayout
        android:id="@+id/inputPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_base"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@color/surface_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_icon"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inputSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/scanSetupPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_choose_session"
                        android:textColor="@color/text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/scan_mode_explanation"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/modeSingle"
                            style="@style/Widget.EasyRead.ModeCard"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_selected"
                            android:drawableTop="@drawable/ic_word"
                            android:text="@string/scan_single"
                            android:textColor="@color/accent_on_primary" />

                        <Button
                            android:id="@+id/modeBatch"
                            style="@style/Widget.EasyRead.ModeCard"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_copy"
                            android:text="@string/scan_batch" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonStartScan"
                        style="@style/Widget.EasyRead.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="18dp"
                        android:drawableStart="@drawable/ic_camera"
                        android:drawablePadding="12dp"
                        android:gravity="center"
                        android:text="@string/open_system_camera"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_pill"
                        android:padding="14dp"
                        android:text="@string/system_camera_quality_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ocrSourcePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ocr_choose_source"
                        android:textColor="@color/text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ocr_detection_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/buttonOcrCamera"
                        style="@style/Widget.EasyRead.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="20dp"
                        android:drawableStart="@drawable/ic_camera"
                        android:drawablePadding="12dp"
                        android:gravity="center"
                        android:text="@string/ocr_camera" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonGallery"
                            style="@style/Widget.EasyRead.ModeCard"
                            android:layout_width="0dp"
                            android:layout_height="118dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_image"
                            android:text="@string/ocr_gallery" />

                        <Button
                            android:id="@+id/buttonFile"
                            style="@style/Widget.EasyRead.ModeCard"
                            android:layout_width="0dp"
                            android:layout_height="118dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_folder"
                            android:text="@string/ocr_pdf_file" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_card"
                        android:lineSpacingExtra="3dp"
                        android:padding="16dp"
                        android:text="@string/ocr_structure_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scanReviewPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:background="@drawable/bg_scan_preview"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/scanPagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/image_preview"
                            android:scaleType="centerInside" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_utility_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="6dp">

                        <Button
                            android:id="@+id/buttonPreviousPage"
                            style="@style/Widget.EasyRead.Button.Secondary"
                            android:layout_width="70dp"
                            android:layout_height="46dp"
                            android:text="@string/previous_page" />

                        <TextView
                            android:id="@+id/scanPageMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/buttonNextPage"
                            style="@style/Widget.EasyRead.Button.Secondary"
                            android:layout_width="70dp"
                            android:layout_height="46dp"
                            android:text="@string/next_page" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_action_shelf"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <Button
                            android:id="@+id/buttonMoveLeft"
                            style="@style/Widget.EasyRead.WorkspaceAction"
                            android:text="@string/move_left" />

                        <Button
                            android:id="@+id/buttonRotatePage"
                            style="@style/Widget.EasyRead.WorkspaceAction"
                            android:text="@string/rotate_page" />

                        <Button
                            android:id="@+id/buttonDeletePage"
                            style="@style/Widget.EasyRead.WorkspaceAction"
                            android:text="@string/delete_page" />

                        <Button
                            android:id="@+id/buttonMoveRight"
                            style="@style/Widget.EasyRead.WorkspaceAction"
                            android:text="@string/move_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonAddPage"
                            style="@style/Widget.EasyRead.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/add_page" />

                        <Button
                            android:id="@+id/buttonFinishScan"
                            style="@style/Widget.EasyRead.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/finish_scan" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/inputProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_secondary"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/privacy_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/view_bottom_navigation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/outputPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_base"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/surface_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/buttonWorkspaceBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:padding="13dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ocr_editable_workspace"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonWorkspaceSearch"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/search"
                android:padding="11dp"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/buttonWorkspaceMore"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/more"
                android:padding="11dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/outputProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_utility_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/textResultMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/no_result_meta"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/buttonTextSmaller"
                style="@style/Widget.EasyRead.TextScale"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="A−" />

            <TextView
                android:id="@+id/textScaleValue"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/text_scale_default"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonTextLarger"
                style="@style/Widget.EasyRead.TextScale"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="A+" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/editResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_document_page"
                android:fadeScrollbars="false"
                android:gravity="start|top"
                android:hint="@string/result_hint"
                android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="30dp"
                android:paddingBottom="24dp"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbarSize="8dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
                android:scrollbarTrackVertical="@drawable/scrollbar_track_vertical"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <ScrollView
                android:id="@+id/tableVerticalScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_document_page"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:padding="12dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls">

                    <TableLayout
                        android:id="@+id/worksheetTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>
            </ScrollView>
        </FrameLayout>

        <TextView
            android:id="@+id/textWorkspaceStatus"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_status_pill"
            android:drawableStart="@drawable/ic_status_dot"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/workspace_ocr_status"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/workspaceActionBar"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_action_shelf"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/buttonCopy"
                style="@style/Widget.EasyRead.WorkspaceAction.Primary"
                android:drawableTop="@drawable/ic_copy"
                android:enabled="false"
                android:text="@string/copy" />

            <Button
                android:id="@+id/buttonShare"
                style="@style/Widget.EasyRead.WorkspaceAction"
                android:drawableTop="@drawable/ic_share"
                android:enabled="false"
                android:text="@string/share" />

            <Button
                android:id="@+id/buttonWorkspaceExport"
                style="@style/Widget.EasyRead.WorkspaceAction"
                android:drawableTop="@drawable/ic_export"
                android:enabled="false"
                android:text="@string/export" />

            <Button
                android:id="@+id/buttonXlsx"
                style="@style/Widget.EasyRead.WorkspaceAction.Excel"
                android:drawableTop="@drawable/ic_excel"
                android:enabled="false"
                android:text="@string/excel_short"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
