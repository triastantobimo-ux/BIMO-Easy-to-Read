<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/appearance"
            android:textColor="@color/accent_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_surface"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/theme_system"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/theme_light"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/theme_dark"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/language"
            android:textColor="@color/accent_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_surface"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/languageIndonesian"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/language_indonesian"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/languageEnglish"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/language_english"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/clipboard"
            android:textColor="@color/accent_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <CheckBox
                android:id="@+id/checkAutoCopy"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/auto_copy"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/checkSensitive"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/sensitive_clip"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonSaveSettings"
            style="@style/Widget.EasyRead.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="@string/save_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:text="@string/privacy_note"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
