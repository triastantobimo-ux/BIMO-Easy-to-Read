<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/buttonPdfBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pdfTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@string/pdf_document"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pdfMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pdf_loading"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonPdfSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pdf_search"
            android:padding="10dp"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/buttonPdfBookmark"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pdf_bookmark"
            android:padding="10dp"
            android:src="@drawable/ic_bookmark" />

        <ImageButton
            android:id="@+id/buttonPdfMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pdf_more_options"
            android:padding="10dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_utility_bar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/buttonPdfPage"
                style="@style/Widget.EasyRead.Button.Secondary"
                android:layout_width="112dp"
                android:layout_height="42dp"
                android:text="@string/pdf_page"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonPdfZoomOut"
                style="@style/Widget.EasyRead.TextScale"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/pdf_zoom_out"
                android:text="−" />

            <Button
                android:id="@+id/buttonPdfZoom"
                style="@style/Widget.EasyRead.Button.Secondary"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:text="100%"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonPdfZoomIn"
                style="@style/Widget.EasyRead.TextScale"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/pdf_zoom_in"
                android:text="+" />

            <Button
                android:id="@+id/buttonPdfLayout"
                style="@style/Widget.EasyRead.Button.Secondary"
                android:layout_width="96dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/pdf_single_page_layout"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/pdfStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_elevated"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:text="@string/pdf_read_capability"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/pdfFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_editor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_action_shelf"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/buttonPdfShare"
            style="@style/Widget.EasyRead.WorkspaceAction"
            android:drawableTop="@drawable/ic_share"
            android:text="@string/share" />

        <Button
            android:id="@+id/buttonPdfAnnotate"
            style="@style/Widget.EasyRead.WorkspaceAction.Primary"
            android:drawableTop="@drawable/ic_edit"
            android:text="@string/pdf_annotate" />

        <Button
            android:id="@+id/buttonPdfSave"
            style="@style/Widget.EasyRead.WorkspaceAction"
            android:drawableTop="@drawable/ic_export"
            android:text="@string/pdf_save_copy" />
    </LinearLayout>
</LinearLayout>

