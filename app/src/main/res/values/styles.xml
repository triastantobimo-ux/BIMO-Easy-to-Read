<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EasyRead.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
        <item name="android:statusBarColor">@color/surface_top</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.EasyRead.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_secondary</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
        <item name="android:statusBarColor">@color/surface_top</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.EasyRead.System" parent="Theme.EasyRead.Light" />

    <style name="Widget.EasyRead.Tab" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.EasyRead.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.EasyRead.Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.EasyRead.Button.Command" parent="Widget.EasyRead.Button.Secondary">
        <item name="android:background">@drawable/bg_button_command</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="Widget.EasyRead.TextScale" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Widget.EasyRead.Nav" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="Widget.EasyRead.Nav.Primary" parent="Widget.EasyRead.Nav">
        <item name="android:background">@drawable/bg_nav_primary</item>
        <item name="android:textColor">@color/accent_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.EasyRead.ModeCard" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Widget.EasyRead.CaptureSide" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">90dp</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="Widget.EasyRead.Link" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.EasyRead.WorkspaceTab" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tab_unselected</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="Widget.EasyRead.WorkspaceAction" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/bg_action_tile</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="Widget.EasyRead.WorkspaceAction.Primary" parent="Widget.EasyRead.WorkspaceAction">
        <item name="android:background">@drawable/bg_action_primary</item>
        <item name="android:textColor">@color/accent_on_primary</item>
    </style>

    <style name="Widget.EasyRead.WorkspaceAction.Excel" parent="Widget.EasyRead.WorkspaceAction">
        <item name="android:background">@drawable/bg_action_excel</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.EasyRead.ExportAction" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_action_tile</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">8sp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="Widget.EasyRead.ExportAction.Primary" parent="Widget.EasyRead.ExportAction">
        <item name="android:background">@drawable/bg_action_primary</item>
        <item name="android:textColor">@color/accent_on_primary</item>
    </style>

</resources>

