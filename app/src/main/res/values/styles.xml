<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EasyRead.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface_light</item>
    </style>

    <style name="Theme.EasyRead.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface_dark</item>
    </style>

    <style name="Theme.EasyRead.System" parent="Theme.EasyRead.Light" />
</resources>
